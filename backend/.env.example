# SmartSearch AI Parser (optional)
# When enabled, /api/search/natural first calls the AI parser service (FastAPI)
AI_PARSER_ENABLED=false
AI_PARSER_URL=http://127.0.0.1:8010
# Backend Configuration

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/G-Mart

# JWT
JWT_SECRET=your_jwt_secret_key

# ML Ranking API
RANKING_API_URL=http://localhost:8000
RANKING_ENABLED=true

# Razorpay (if applicable)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_SECRET_KEY=your_razorpay_secret_key


